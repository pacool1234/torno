# Copy to .env (git-ignored) and fill in. Never commit real values.

# Anthropic API key, used to record test fixtures and for the demo with
# Claude Haiku. Local development with Ollama doesn't need it.
ANTHROPIC_API_KEY=

# Where requests go (default https://api.anthropic.com). For a local model
# through Ollama, set http://localhost:11434 and leave the API key empty.
ANTHROPIC_BASE_URL=

# Which model to use (default claude-haiku-4-5). For Ollama, e.g. gemma4:e4b.
TORNO_MODEL=
